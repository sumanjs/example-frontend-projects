{
  "name": "suman-requirejs",
  "version": "0.0.1",
  "description": "Suman requirejs example",
  "main": "index.js",
  "scripts": {
    "test": "suman",
    "lint:ores": "if [ -f ../../.ores-lint/lint.sh ]; then sh ../../.ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sumanjs/example-frontend-projects.git"
  },
  "keywords": [
    "sumanjs",
    "testing",
    "unit",
    "testing",
    "front-end",
    "testing"
  ],
  "author": "Olegzandr VD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sumanjs/example-frontend-projects/issues"
  },
  "homepage": "https://github.com/sumanjs/example-frontend-projects#readme",
  "devDependencies": {
    "suman": "^1.1.51230"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
